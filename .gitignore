# Python cache
__pycache__/
*.py[cod]

# Virtual environments
.venv/

# Trained models and logs
*.pth
*.csv

# Generated experiment results: local only, except the published Deep-Q results
# (built by `python -m dqn.make_test_results`). "test_result/*" instead of "test_result/" so the
# exceptions below can re-include subfolders.
test_result/*
!test_result/mlp/
!test_result/hybrid/
test_result/hybrid/visualizations/
# Scoped to its folder: Git on Windows is case-insensitive, so a bare "Test_result/" also
# matched (and re-ignored) the published test_result/ folders above.
dqn/Test_result/
# DQN v2 training logs
dqn/v2/*.log

# Kept local only (not published)
q_*.pkl
q_*.json
report/
dqn/v2/eval/
dqn/v2/figures/
dqn/v2/runs/
